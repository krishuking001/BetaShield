# Copy this file to android/key.properties (same folder as this example) and
# fill in your own release keystore. Never commit the real key.properties or
# your .jks/.keystore file — both are already in android/.gitignore.
#
# Generate a keystore with (see README → "Signing" for the full walkthrough):
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=../upload-keystore.jks
