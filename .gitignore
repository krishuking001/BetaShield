# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Android build cache (not the published outputs — those already live under
# the ignored /build/ above, but Gradle's own cache doesn't).
android/.gradle/

# Secrets — never commit these. See README.md -> "Signing" / "Firebase" and
# backend/server/.env.example.
android/key.properties
*.jks
*.keystore
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
*serviceAccount*.json
.env

# Built app binaries — regenerate from source, don't version them.
*.apk
*.aab
