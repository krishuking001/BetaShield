# Copy to .env for local dev (`npm run dev`). In production (Render, etc.)
# set these as real environment variables in the host's dashboard instead —
# never commit a real .env file.

# Supabase → Project Settings → Database → Connection string → "Session pooler"
# (NOT "Transaction pooler"/6543 — this server holds its own long-lived
# connection pool via `pg.Pool`, so it wants a pooler that gives each
# connection full session semantics, which only the session pooler does.
# The transaction pooler is for serverless/edge functions that can't hold
# a persistent pool themselves. Note the username is "postgres.<project-ref>",
# not just "postgres" — the pooler needs it to route to your project).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Firebase → Project settings → Service accounts → Generate new private key.
# Base64-encode the whole downloaded JSON file and paste the result here:
#   (macOS/Linux) base64 -i service-account.json | tr -d '\n'
#   (Windows PowerShell) [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Only needed for push notifications (FCM) — the server runs fine without it,
# it just won't be able to notify guardians.
FIREBASE_SERVICE_ACCOUNT_JSON=

# A long random string only you and your scheduler know. Protects the
# /internal/weekly-report-push endpoint from being called by anyone else.
# Generate one with: openssl rand -hex 32
INTERNAL_CRON_SECRET=

PORT=8080
